# Copy to .env and fill in your own key
OPENROUTER_API_KEY=sk-or-v1-...your-key
# JEV decision model (pinned to the current release, 1.14)
JEV_MODEL=typesafe/jev-1.14
# Cheap chat model used only to interpret the question into criteria + oracle prose
CHEAP_MODEL=~deepseek/deepseek-flash-latest
# Optional: your deployed frontend URL (for OpenRouter attribution headers)
SITE_URL=https://your-site.example
